{
  "name": "frontend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ui:add": "shadcn add"
  },
  "dependencies": {
    "@reduxjs/toolkit": "1.9.7",
    "axios": "1.12.2",
    "class-variance-authority": "^0.7.1",
